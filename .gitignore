# =============================================================================
# Root .gitignore (global) for xp-notebook-lm
# Covers Node, Next.js, Prisma, TypeScript, OS, editors, and AI tooling
# =============================================================================

### Node ###
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env*

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

### Node Patch ###
# Serverless Webpack directories
.webpack/

# SvelteKit build / generate output
.svelte-kit

### Next.js ###
# Vercel
.vercel

# Build output
/build

### Prisma ###
# Generated Prisma client (keep schema, ignore generated output)
/generated/prisma
**/generated/prisma
server/src/generated/prisma

# Prisma migration lock & local cache (optional; uncomment if needed)
# prisma/migrations/dev.db*

### TypeScript ###
next-env.d.ts

### OS ###
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

### Editors / IDEs ###
# VS Code (keep settings out of repo unless shared intentionally)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo

# Cursor / other editors
.cursor/

### AI Tooling (do NOT commit agent/assistant config & lockfiles) ###
# Claude Code
.claude/
**/.claude/
CLAUDE.md
**/CLAUDE.md

# Agents
.agents/
**/.agents/
AGENTS.md
**/AGENTS.md

# Windsurf
.windsurf/
**/.windsurf/

# Cline / Roo / other agent skills lockfiles
skills-lock.json
**/skills-lock.json

# Continue.dev
.continue/
**/.continue/

# GitHub Copilot
.github/copilot/

# General agent/assistant artifacts
.agent/
**/.agent/
.assistant/
**/.assistant/

### Security / Secrets ###
# Environment & secret files
.env
.env.*
!.env.example
!.env.template

# Key files
*.pem
*.key
*.cert
*.p12
*.pfx

### Misc ###
# Lockfiles for package managers are intentionally KEPT (package-lock.json, yarn.lock, pnpm-lock.yaml)
# Uncomment the following if you do NOT want to commit lockfiles:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Docker local volumes / data
docker-data/
.docker/

# Misc debug / temp
*.tmp
*.temp
*.bak
*.orig